# Clave service_role (SECRETA) — para registrar pagos en el servidor
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# --- Stripe ---  (Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta
